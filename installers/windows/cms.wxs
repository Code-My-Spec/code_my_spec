<?xml version="1.0" encoding="utf-8"?>
<!--
  CodeMySpec Windows installer (WiX v5).

  Installs the plain `mix release` folder (ERTS + start.boot on disk, no
  runtime self-extraction) into %ProgramFiles%\CodeMySpec, plus shawl.exe, and
  registers a "CodeMySpec" Windows service: Shawl wrapping the release launcher
  `cmd /c bin\code_my_spec_cli.bat start`.

  - Shawl is the service binary; it supervises the BEAM, forwards the service
    stop into a ctrl-C, restarts on nonzero exit. kill-process-tree tears the
    cmd to launcher to erl child chain down on stop.
  - LocalSystem (no password). Data dir is machine-wide C:\ProgramData\CodeMySpec
    (LocalSystem has no user profile), passed via the CMS_HOME env and also set
    as a machine env var so a user-run cms resolves the same directory.
  - Updates: a newer MSI (MajorUpgrade). The release no longer self-updates.

  CI builds this from inside the release folder (so Include="**" harvests the
  tree), with shawl.exe copied in alongside. Version templated: __CMS_VERSION__.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="CodeMySpec"
    Manufacturer="CodeMySpec"
    Version="__CMS_VERSION__"
    UpgradeCode="835D3096-67DE-44CC-B879-04AEFAA1D771"
    Scope="perMachine"
    Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of CodeMySpec is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="CodeMySpec" />
    </StandardDirectory>

    <!-- Harvest the whole release tree, minus shawl.exe (own component below)
         and the wxs itself. Build runs from inside the release folder, so the
         glob is relative to it. -->
    <ComponentGroup Id="ReleaseTree" Directory="INSTALLFOLDER">
      <Files Include="**" Exclude="shawl.exe;cms.wxs" />
    </ComponentGroup>

    <ComponentGroup Id="ServiceComponent" Directory="INSTALLFOLDER">
      <Component Id="ShawlService">
        <File Id="shawl.exe" Source="shawl.exe" KeyPath="yes" />
        <ServiceInstall
          Id="CodeMySpecService"
          Name="CodeMySpec"
          DisplayName="CodeMySpec Local Server"
          Description="CodeMySpec local server (Phoenix + MCP) on port 4003, supervised by Shawl."
          Type="ownProcess"
          Start="auto"
          ErrorControl="normal"
          Vital="yes"
          Arguments="run --name CodeMySpec --kill-process-tree --stop-timeout 20000 --cwd &quot;C:\ProgramData\CodeMySpec&quot; --log-dir &quot;C:\ProgramData\CodeMySpec\shawl&quot; --env CMS_HOME=C:\ProgramData\CodeMySpec -- cmd /c &quot;[INSTALLFOLDER]bin\code_my_spec_cli.bat&quot; start" />
        <ServiceControl
          Id="CodeMySpecServiceControl"
          Name="CodeMySpec"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
      </Component>
    </ComponentGroup>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DataFolder" Name="CodeMySpec" />
    </StandardDirectory>
    <ComponentGroup Id="DataDir" Directory="DataFolder">
      <Component Id="DataFolderComponent">
        <CreateFolder />
        <Environment
          Id="CmsHomeEnv"
          Name="CMS_HOME"
          Value="C:\ProgramData\CodeMySpec"
          System="yes"
          Action="set"
          Part="all" />
        <RegistryValue
          Root="HKLM"
          Key="Software\CodeMySpec"
          Name="installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="CodeMySpec" Level="1">
      <ComponentGroupRef Id="ReleaseTree" />
      <ComponentGroupRef Id="ServiceComponent" />
      <ComponentGroupRef Id="DataDir" />
    </Feature>
  </Package>
</Wix>
