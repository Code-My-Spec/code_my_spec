<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content={get_csrf_token()} />
  <title><%= assigns[:page_title] || "CodeMySpec" %></title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: #0f172a;
      color: #e2e8f0;
    }
    a { color: #60a5fa; text-decoration: none; }
    a:hover { text-decoration: underline; }
    h1 { font-size: 20px; margin-bottom: 8px; }
    h2 { font-size: 16px; margin: 24px 0 8px; color: #94a3b8; }
    pre {
      background: #1e293b;
      padding: 16px;
      border-radius: 8px;
      overflow-x: auto;
      white-space: pre-wrap;
      font-size: 13px;
      line-height: 1.5;
    }
    code {
      background: #1e293b;
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 13px;
    }
    .container { max-width: 800px; margin: 0 auto; padding: 24px; }
    .progress { background: #1e293b; border-radius: 8px; height: 8px; margin-bottom: 24px; overflow: hidden; }
    .progress-bar { background: #4ade80; height: 100%; }
    .subtitle { color: #94a3b8; font-size: 14px; margin-bottom: 16px; }
    .back-link { display: inline-block; margin-bottom: 16px; font-size: 14px; }

    /* Checklist table */
    table.checklist { width: 100%; border-collapse: collapse; }
    table.checklist tr { border-bottom: 1px solid #1e293b; }
    table.checklist td { padding: 10px 8px; vertical-align: top; }
    table.checklist .icon { width: 24px; font-size: 16px; text-align: center; }
    table.checklist .done .icon { color: #4ade80; }
    table.checklist .actionable .icon { color: #fbbf24; }
    table.checklist .blocked .icon { color: #475569; }
    table.checklist .blocked { color: #64748b; }
    .tag { font-size: 11px; padding: 2px 6px; border-radius: 4px; background: #334155; color: #94a3b8; }
    .detail { color: #94a3b8; font-size: 13px; display: block; margin-top: 2px; }
    .status-done { color: #4ade80; }
    .status-blocked { color: #64748b; }
    .status-actionable { color: #fbbf24; }
  </style>
</head>
<body>
  <div class="container">
    <%= @inner_content %>
  </div>
  <script src="/local/assets/js/local_app.js">
  </script>
</body>
</html>
