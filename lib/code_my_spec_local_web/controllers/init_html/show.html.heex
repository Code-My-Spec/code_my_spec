<a href={"/init?dir=#{@dir_param}"} class="back-link">&larr; Back to checklist</a>
<h1><%= @step.name %></h1>

<div style="margin-bottom: 24px;">
  <%= case @status do %>
    <% :done -> %>
      <span class="status-done">Done</span>
    <% :blocked -> %>
      <span class="status-blocked">Blocked</span> — waiting on: <%= Enum.join(@step.prereqs, ", ") %>
    <% {:not_done, detail} -> %>
      <span class="status-actionable">Not done</span> — <%= detail %>
  <% end %>
</div>

<%= if @prompt_text do %>
  <h2>Instructions</h2>
  <pre><%= @prompt_text %></pre>
<% end %>
