<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="icon" href={~p"/favicon.ico"} sizes="any" />
    <link rel="manifest" href={~p"/manifest.json"} />
    <link rel="apple-touch-icon" href={~p"/images/logo-300.png"} />
    <.live_title default="CodeMySpec">
      {assigns[:page_title] || assigns[:meta_title]}
    </.live_title>
    
<!-- SEO Meta Tags -->
    <meta
      :if={assigns[:meta_description]}
      name="description"
      content={assigns[:meta_description]}
    />
    
<!-- Open Graph Meta Tags -->
    <meta property="og:title" content={assigns[:og_title] || assigns[:page_title] || "CodeMySpec"} />
    <meta
      property="og:description"
      content={assigns[:og_description] || assigns[:meta_description] || "AI-assisted Phoenix development that actually ships"}
    />
    <meta property="og:image" content={assigns[:og_image] || CodeMySpecWeb.ImageUrl.image_url("og-default.png", CodeMySpecWeb.Endpoint.url())} />
    <meta property="og:type" content={assigns[:og_type] || "website"} />
    <meta property="og:url" content={assigns[:canonical_url] || CodeMySpecWeb.Endpoint.url()} />
    <meta property="og:site_name" content="CodeMySpec" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta :if={assigns[:og_type] == "article" and assigns[:article_published_time]} property="article:published_time" content={assigns[:article_published_time]} />
    <meta :if={assigns[:og_type] == "article"} property="article:author" content="John Davenport" />
    <link :if={assigns[:canonical_url]} rel="canonical" href={assigns[:canonical_url]} />
<!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@johns10d" />
    <meta name="twitter:title" content={assigns[:og_title] || assigns[:page_title] || "CodeMySpec"} />
    <meta name="twitter:description" content={assigns[:og_description] || assigns[:meta_description] || "AI-assisted Phoenix development that actually ships"} />
    <meta name="twitter:image" content={assigns[:og_image] || CodeMySpecWeb.ImageUrl.image_url("og-default.png", CodeMySpecWeb.Endpoint.url())} />
    <%= if assigns[:json_ld_list] do %>
      <%= for item <- assigns[:json_ld_list] do %>
        <script type="application/ld+json"><%= raw(item) %></script>
      <% end %>
    <% else %>
      <%= if assigns[:json_ld] do %>
        <script type="application/ld+json"><%= raw(assigns[:json_ld]) %></script>
      <% end %>
    <% end %>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=JetBrains+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=JetBrains+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=JetBrains+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    </noscript>
    <meta name="author" content="John Davenport" />

    <link
      :if={assigns[:preload_image]}
      rel="preload"
      as="image"
      href={@preload_image}
      fetchpriority="high"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-EHBYEW52MM">
    </script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-EHBYEW52MM');
      window.GA_MEASUREMENT_ID = 'G-EHBYEW52MM'; // Add this line
    </script>

    <script>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        window.addEventListener("phx:set-theme", ({ detail: { theme } }) => setTheme(theme));
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
