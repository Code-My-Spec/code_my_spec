<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="icon" href={~p"/favicon.ico"} sizes="any" />
    <link
      rel="alternate"
      type="application/atom+xml"
      title="CodeMySpec Blog"
      href={~p"/blog/feed.xml"}
    />
    <link rel="manifest" href={~p"/manifest.json"} />
    <link rel="apple-touch-icon" href={~p"/images/logo-300.png"} />
    <.live_title default="CodeMySpec">
      {assigns[:page_title] || assigns[:meta_title]}
    </.live_title>
    
<!-- SEO Meta Tags -->
    <meta
      :if={assigns[:meta_description]}
      name="description"
      content={assigns[:meta_description]}
    />
    
<!-- Open Graph Meta Tags -->
    <meta property="og:title" content={assigns[:og_title] || assigns[:page_title] || "CodeMySpec"} />
    <meta
      property="og:description"
      content={assigns[:og_description] || assigns[:meta_description] || "AI-assisted Phoenix development that actually ships"}
    />
    <meta property="og:image" content={assigns[:og_image] || CodeMySpecWeb.ImageUrl.image_url("og-default.png", CodeMySpecWeb.Endpoint.url())} />
    <meta property="og:type" content={assigns[:og_type] || "website"} />
    <meta property="og:url" content={assigns[:canonical_url] || CodeMySpecWeb.Endpoint.url()} />
    <meta property="og:site_name" content="CodeMySpec" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta :if={assigns[:og_type] == "article" and assigns[:article_published_time]} property="article:published_time" content={assigns[:article_published_time]} />
    <meta :if={assigns[:og_type] == "article"} property="article:author" content="John Davenport" />
    <link :if={assigns[:canonical_url]} rel="canonical" href={assigns[:canonical_url]} />
<!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@johns10d" />
    <meta name="twitter:title" content={assigns[:og_title] || assigns[:page_title] || "CodeMySpec"} />
    <meta name="twitter:description" content={assigns[:og_description] || assigns[:meta_description] || "AI-assisted Phoenix development that actually ships"} />
    <meta name="twitter:image" content={assigns[:og_image] || CodeMySpecWeb.ImageUrl.image_url("og-default.png", CodeMySpecWeb.Endpoint.url())} />
    <%= if assigns[:json_ld_list] do %>
      <%= for item <- assigns[:json_ld_list] do %>
        <script type="application/ld+json" nonce={assigns[:csp_nonce]}><%= raw(item) %></script>
      <% end %>
    <% else %>
      <%= if assigns[:json_ld] do %>
        <script type="application/ld+json" nonce={assigns[:csp_nonce]}><%= raw(assigns[:json_ld]) %></script>
      <% end %>
    <% end %>

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={~p"/fonts/ibm-plex-sans-latin.woff2"}
      crossorigin
    />
    <meta name="author" content="John Davenport" />

    <link
      :if={assigns[:preload_image]}
      rel="preload"
      as="image"
      href={@preload_image}
      imagesrcset={assigns[:preload_image_srcset]}
      imagesizes={assigns[:preload_image_sizes]}
      fetchpriority="high"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>

    <%
      ga_measurement_id =
        Application.get_env(:code_my_spec, CodeMySpec.Analytics.GoogleAnalytics, [])
        |> Keyword.get(:measurement_id)
    %>
    <%= if ga_measurement_id do %>
      <%!-- gtag.js: browser pageviews, sessions, engagement, bot exclusion, referrer attribution.
           Deferred to first interaction (or 3.5s idle fallback) to keep GTM's ~180KB off the
           critical load path (audit 2026-07-10: desktop TBT 390ms). The dataLayer stub below is
           synchronous, so gtag() calls made before the script arrives are queued and flush on load.
           /users/register loads eagerly: the GaClientId stitch (rule f9b2c751) wants the _ga
           cookies present as early as possible on a direct signup landing. --%>
      <script nonce={assigns[:csp_nonce]}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '<%= ga_measurement_id %>');
        (() => {
          let loaded = false;
          const load = () => {
            if (loaded) return;
            loaded = true;
            const s = document.createElement("script");
            s.async = true;
            s.src = "https://www.googletagmanager.com/gtag/js?id=<%= ga_measurement_id %>";
            document.head.appendChild(s);
            events.forEach((e) => removeEventListener(e, load, opts));
          };
          const events = ["pointerdown", "keydown", "touchstart", "scroll"];
          const opts = { once: true, passive: true, capture: true };
          if (location.pathname.startsWith("/users/register")) {
            load();
          } else {
            events.forEach((e) => addEventListener(e, load, opts));
            if ("requestIdleCallback" in window) {
              requestIdleCallback(load, { timeout: 3500 });
            } else {
              setTimeout(load, 3500);
            }
          }
        })();
      </script>
    <% end %>

    <script nonce={assigns[:csp_nonce]}>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        window.addEventListener("phx:set-theme", ({ detail: { theme } }) => setTheme(theme));
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
