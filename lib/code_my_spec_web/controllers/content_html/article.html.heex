<Layouts.marketing flash={@flash} current_scope={@current_scope}>
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <!-- Series sidebar (only when series exists) -->
      <aside :if={@series_info} class="lg:col-span-1 order-2 lg:order-1">
        <div class="sticky top-4">
          <h3 class="font-semibold text-lg mb-2">{@series_info.name}</h3>
          <nav class="flex flex-col gap-1">
            <a
              :for={post <- @series_info.posts}
              href={post.path}
              class={"block text-sm px-3 py-2 rounded-lg transition-colors #{if post.slug == @series_info.current_slug, do: "bg-primary/10 text-primary font-medium", else: "hover:bg-base-200 text-base-content/70"}"}
            >
              <span :if={get_in(post.metadata || %{}, ["metadata", "series_part"])} class="text-xs opacity-60 mr-1">
                {get_in(post.metadata || %{}, ["metadata", "series_part"])}.
              </span>
              {post.title || post.slug}
            </a>
          </nav>
        </div>
      </aside>

      <article class={"order-1 lg:order-2 w-full min-w-0 #{if @series_info, do: "lg:col-span-3", else: "lg:col-span-4 max-w-4xl mx-auto"}"}>
        <!-- Series banner -->
        <div :if={@series_info} class="mb-6 flex items-center gap-2 text-sm text-base-content/60">
          <.icon name="hero-document-text" class="w-4 h-4" />
          <span>Part of the <strong class="text-base-content/80">{@series_info.name}</strong> series</span>
        </div>

        <%= if hero_image = blog_hero_image(@content) do %>
          <img
            src={hero_image}
            srcset={blog_hero_srcset(@content)}
            sizes={blog_hero_sizes()}
            alt={@content.title || @content.slug}
            class="w-full rounded-lg mb-8"
            width="1024"
            height="576"
            loading="eager"
            fetchpriority="high"
          />
        <% end %>

        <header class="mb-8">
          <h1 class="text-4xl font-bold tracking-tight mb-4">{@content.title || @content.slug}</h1>
          <div class="flex items-center gap-3 text-sm text-base-content/60 mb-4">
            <a href="/author/john-davenport" class="link link-hover hover:text-primary transition-colors">By John Davenport</a>
            <span>&middot;</span>
            <span>{format_publish_date(@content.publish_at)}</span>
          </div>
          <div :if={!Enum.empty?(@tags)} class="flex gap-2 flex-wrap">
            <span :for={tag <- @tags} class="badge badge-secondary badge-outline">
              {tag.name}
            </span>
          </div>
        </header>

        <div class="prose prose-lg max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-primary">
          <%= if @content.processed_content do %>
            {raw(strip_leading_h1(@content.processed_content))}
          <% else %>
            <div class="opacity-60 italic">
              Content not available
            </div>
          <% end %>
        </div>

        <Layouts.install_signature :if={@content.content_type == :blog} />

        <!-- Prev/Next navigation -->
        <div :if={@series_info && (@series_info.prev_post || @series_info.next_post)} class="mt-12 pt-8 border-t border-base-300">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <a
                :if={@series_info.prev_post}
                href={@series_info.prev_post.path}
                class="block card bg-base-100 border border-base-300 hover:shadow-lg transition-shadow h-full"
              >
                <div class="card-body py-4 px-5">
                  <span class="text-xs text-base-content/50">Previous</span>
                  <span class="font-medium text-sm">{@series_info.prev_post.title}</span>
                </div>
              </a>
            </div>
            <div class="text-right">
              <a
                :if={@series_info.next_post}
                href={@series_info.next_post.path}
                class="block card bg-base-100 border border-base-300 hover:shadow-lg transition-shadow h-full"
              >
                <div class="card-body py-4 px-5 items-end">
                  <span class="text-xs text-base-content/50">Next</span>
                  <span class="font-medium text-sm">{@series_info.next_post.title}</span>
                </div>
              </a>
            </div>
          </div>
        </div>
      </article>
    </div>
  </div>

  <script>
    setTimeout(function() {
      if (typeof gtag === "function") {
        gtag('event', 'deep_content_read', {
          content_category: document.title,
          page_path: window.location.pathname
        });
      }
    }, 60000);
  </script>
</Layouts.marketing>
