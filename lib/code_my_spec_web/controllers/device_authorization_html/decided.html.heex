<div class="hero min-h-screen bg-base-200">
  <div class="hero-content text-center">
    <div class="max-w-md">
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <%= if @approved? do %>
            <.header>
              <.icon name="hero-check-circle" class="size-8 text-success mb-2" /> Device connected
              <:subtitle>
                You can close this page. The device will pick this up on its own.
              </:subtitle>
            </.header>
          <% else %>
            <.header>
              <.icon name="hero-x-circle" class="size-8 text-error mb-2" /> Device not connected
              <:subtitle>
                You denied the request. You can close this page.
              </:subtitle>
            </.header>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
