<Layouts.marketing flash={@flash} current_scope={@current_scope} page_title={@page_title}>
  <%!-- ───────────── HERO ───────────── --%>
  <section class="bg-base-200 border-b border-base-300">
    <div class="max-w-6xl mx-auto px-6 py-16 lg:py-24 grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div>
        <div class="badge badge-primary badge-outline gap-2 mb-6">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-primary"></span>
          Build · Operate · Grow — from one seat
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.05]">
          You do the thinking.<br />
          <span class="text-primary">The machine does the labor.</span>
        </h1>
        <p class="text-lg text-base-content/70 mt-6 max-w-lg leading-relaxed">
          Together you build the software, run the email and chat your customers reach you on,
          and do the outreach that grows it — the work of a whole team, without being one.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <.link href={~p"/users/register"} class="btn btn-primary btn-lg">Start free</.link>
          <a href="#jobs" class="btn btn-ghost btn-lg">See how it works</a>
        </div>
        <p class="mt-6 text-sm text-base-content/60">
          You steer · <span class="font-semibold text-base-content">it does the heavy lifting</span>. Not automation — leverage.
        </p>
      </div>

      <%!-- Hero media: a real operator's inbox --%>
      <div class="card bg-base-100 border border-base-300 shadow-xl">
        <div class="flex items-center gap-3 px-5 py-4 border-b border-base-300">
          <div class="avatar avatar-placeholder">
            <div class="w-10 rounded-lg bg-secondary text-secondary-content">
              <span class="text-sm font-bold">MB</span>
            </div>
          </div>
          <div class="min-w-0">
            <div class="font-semibold leading-tight">Marla's Bakery</div>
            <div class="text-xs text-base-content/60">shared inbox · you + the model</div>
          </div>
          <span class="badge badge-success badge-sm gap-1 ml-auto">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-current"></span> Live
          </span>
        </div>
        <div class="p-5 bg-base-200/40">
          <div class="chat chat-start">
            <div class="chat-bubble text-sm">Hi! Do you do custom cakes for about 40 people? Need it for the 22nd 🎂</div>
          </div>
          <div class="chat chat-start">
            <div class="chat-footer text-xs text-base-content/50 mt-1">Dana · from the chat widget on your site</div>
          </div>
          <div class="chat chat-end">
            <div class="chat-bubble chat-bubble-primary text-sm">
              We do! A 40-person tiered cake runs $180–220. Want me to pencil in the 22nd and send a few designs?
            </div>
          </div>
          <div class="chat chat-start">
            <div class="chat-bubble text-sm">Yes please!</div>
          </div>
        </div>
        <div class="px-5 py-3 border-t border-base-300 text-xs text-base-content/60">
          Replying from
          <span class="badge badge-ghost badge-sm font-medium">hello@marlasbakery.com</span>
          · your domain, your inbox
        </div>
      </div>
    </div>
  </section>

  <%!-- ───────────── WHAT IT DOES ───────────── --%>
  <section id="jobs" class="border-b border-base-300">
    <div class="max-w-6xl mx-auto px-6 py-16 lg:py-24">
      <.eyebrow name="what it does" />
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mt-3 max-w-xl">
        Building it is just the start.
      </h2>
      <p class="text-lg text-base-content/70 mt-4 max-w-2xl leading-relaxed">
        Whether it's a product you sell or a tool that runs your business, software has to be
        built, kept running, and — if you're selling it — put in front of people. That used to
        mean hiring three teams. Now it's you and the model, working through it together.
      </p>

      <div class="grid md:grid-cols-3 gap-5 mt-12">
        <div class="card bg-base-100 border border-base-300 border-t-4 border-t-primary shadow-sm">
          <div class="card-body">
            <span class="text-xs font-semibold uppercase tracking-[0.15em] text-primary">Build</span>
            <h3 class="card-title mt-1">Real software, not a demo.</h3>
            <p class="text-base-content/70">
              Tell it what you want and shape it together — an app your customers actually log
              into, that doesn't fall over when the tenth person shows up.
            </p>
            <span class="text-sm font-medium text-primary mt-2">Free, always →</span>
          </div>
        </div>

        <div class="card bg-base-100 border border-base-300 border-t-4 border-t-secondary shadow-sm">
          <div class="card-body">
            <span class="text-xs font-semibold uppercase tracking-[0.15em] text-secondary">Operate</span>
            <h3 class="card-title mt-1">Run it like a business.</h3>
            <p class="text-base-content/70">
              Email on your own domain and live chat, handled from one inbox. Your customers
              reach a real business. You never touch a server.
            </p>
            <span class="text-sm font-medium text-secondary mt-2">Product or internal tool →</span>
          </div>
        </div>

        <div class="card bg-base-100 border border-base-300 border-t-4 border-t-accent shadow-sm">
          <div class="card-body">
            <span class="text-xs font-semibold uppercase tracking-[0.15em] text-accent">Grow</span>
            <h3 class="card-title mt-1">Find the next customer.</h3>
            <p class="text-base-content/70">
              Publish your content, run your Google Ads, and see who's actually converting —
              so growth isn't a second full-time job.
            </p>
            <span class="text-sm font-medium text-accent mt-2">When you're selling to the world →</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%!-- ───────────── WHO IT'S FOR ───────────── --%>
  <section class="border-b border-base-300 bg-base-200">
    <div class="max-w-6xl mx-auto px-6 py-16 lg:py-24">
      <.eyebrow name="who it's for" />
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mt-3">
        For operators, <span class="text-primary">not engineers.</span>
      </h2>
      <p class="text-lg text-base-content/70 mt-4 max-w-2xl leading-relaxed">
        You run a real business. You've seen what AI can do and you know it should be doing more
        for you — but every tool that promises it assumes you're a developer. This one doesn't.
        You bring the judgment about your business; the model does the building and the running,
        with you calling the shots.
      </p>
      <div class="mt-6 border-l-4 border-base-content/20 pl-5 max-w-2xl text-base-content/60 italic">
        If you're a developer who wants to wire up your own tools — you don't need this. You can
        build it yourself. This is for the people who can't, and shouldn't have to.
      </div>
    </div>
  </section>

  <%!-- ───────────── TWO WAYS IN ───────────── --%>
  <section id="start" class="border-b border-base-300">
    <div class="max-w-6xl mx-auto px-6 py-16 lg:py-24">
      <.eyebrow name="how you start" />
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mt-3">
        Do it yourself, or do it with me.
      </h2>

      <div class="grid md:grid-cols-2 gap-5 mt-12">
        <div class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body">
            <span class="text-xs font-semibold uppercase tracking-[0.15em] text-primary">Drive it yourself</span>
            <h3 class="card-title mt-1">Sit down and build</h3>
            <p class="text-base-content/70">
              Start free. Work with the model, ship the first version, own everything you make.
            </p>
            <div class="card-actions mt-3">
              <.link href={~p"/users/register"} class="btn btn-primary">Start free</.link>
            </div>
          </div>
        </div>

        <div class="card bg-neutral text-neutral-content shadow-lg">
          <div class="card-body">
            <span class="text-xs font-semibold uppercase tracking-[0.15em] opacity-70">Build it with me</span>
            <h3 class="card-title mt-1">Bring the business — we build it together</h3>
            <p class="opacity-80">
              Want the result without learning the tooling? We get on a call, build the first
              version together, then hand you the keys to run it.
            </p>
            <p class="text-sm font-medium text-secondary mt-1">This is how most people start.</p>
            <div class="card-actions mt-3">
              <a href={ExternalLinks.cal_john()} class="btn btn-secondary">Talk to John</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%!-- ───────────── PROOF ───────────── --%>
  <section class="border-b border-base-300 bg-base-200">
    <div class="max-w-6xl mx-auto px-6 py-16 lg:py-24">
      <.eyebrow name="proof" />
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center mt-6">
        <div>
          <blockquote class="text-2xl md:text-3xl font-medium leading-snug tracking-tight">
            I run my whole company on it. <span class="text-primary">One person.</span>
            This site, the app, the email that reaches you from me, the blog, even the marketing
            that put this page in front of you.
          </blockquote>
          <div class="flex items-center gap-3 mt-6">
            <div class="avatar avatar-placeholder">
              <div class="w-11 rounded-lg bg-primary text-primary-content">
                <span class="font-bold">JD</span>
              </div>
            </div>
            <div class="text-sm text-base-content/70">
              <span class="font-semibold text-base-content">John Davenport</span>
              — building CodeMySpec with the model, solo, in real time.
            </div>
          </div>
        </div>

        <div class="flex flex-col gap-3">
          <div class="card bg-base-100 border border-base-300 shadow-sm">
            <div class="card-body py-4">
              <div class="flex items-baseline gap-3">
                <span class="font-semibold">MetricFlow</span>
                <span class="badge badge-primary badge-sm">13 days</span>
              </div>
              <p class="text-sm text-base-content/60">A real app with real integrations, built end to end.</p>
            </div>
          </div>
          <div class="card bg-base-100 border border-base-300 shadow-sm">
            <div class="card-body py-4">
              <div class="flex items-baseline gap-3">
                <span class="font-semibold">Fuellytics</span>
                <span class="badge badge-primary badge-sm">live</span>
              </div>
              <p class="text-sm text-base-content/60">A client product in the hands of paying customers.</p>
            </div>
          </div>
          <div class="card bg-base-100 border border-base-300 shadow-sm">
            <div class="card-body py-4">
              <div class="flex items-baseline gap-3">
                <span class="font-semibold">This website</span>
                <span class="badge badge-primary badge-sm">recursive</span>
              </div>
              <p class="text-sm text-base-content/60">And every email, chat, and post you get from us — same way.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%!-- ───────────── PRICING ───────────── --%>
  <section id="pricing" class="border-b border-base-300">
    <div class="max-w-6xl mx-auto px-6 py-16 lg:py-24">
      <.eyebrow name="pricing" />
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mt-3">
        Free to build. Pay when it's running.
      </h2>
      <p class="text-lg text-base-content/70 mt-4 max-w-2xl leading-relaxed">
        We never mark up the AI that powers it — bring your own keys and pay the AI company directly.
      </p>

      <div class="grid md:grid-cols-2 gap-5 mt-12 max-w-3xl">
        <div class="card bg-base-100 border-2 border-primary shadow-sm">
          <div class="card-body">
            <span class="text-xs font-semibold uppercase tracking-[0.15em] text-base-content/60">Build</span>
            <div class="text-4xl font-bold mt-1">$0 <span class="text-base font-normal text-base-content/50">/ forever</span></div>
            <p class="text-base-content/70">Build your app and see it work. Own what you make.</p>
            <ul class="mt-3 space-y-2 text-sm">
              <li class="flex gap-2"><.icon name="hero-check" class="size-4 text-primary shrink-0 mt-0.5" /> Build real software with the model</li>
              <li class="flex gap-2"><.icon name="hero-check" class="size-4 text-primary shrink-0 mt-0.5" /> Bring your own AI keys, no markup</li>
              <li class="flex gap-2"><.icon name="hero-check" class="size-4 text-primary shrink-0 mt-0.5" /> Yours to keep — no lock-in</li>
            </ul>
            <div class="card-actions mt-4">
              <.link href={~p"/users/register"} class="btn btn-primary btn-block">Start free</.link>
            </div>
          </div>
        </div>

        <div class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body">
            <span class="text-xs font-semibold uppercase tracking-[0.15em] text-base-content/60">Operate &amp; Grow</span>
            <div class="text-4xl font-bold mt-1">
              $100 <span class="text-base font-normal text-base-content/50">/ month</span>
            </div>
            <p class="text-base-content/70">Everything after launch, in one place.</p>
            <ul class="mt-3 space-y-2 text-sm">
              <li class="flex gap-2"><.icon name="hero-check" class="size-4 text-secondary shrink-0 mt-0.5" /> Email on your own domain</li>
              <li class="flex gap-2"><.icon name="hero-check" class="size-4 text-secondary shrink-0 mt-0.5" /> Live chat + one shared inbox</li>
              <li class="flex gap-2"><.icon name="hero-check" class="size-4 text-secondary shrink-0 mt-0.5" /> Content publishing + Google Ads</li>
              <li class="flex gap-2"><.icon name="hero-check" class="size-4 text-secondary shrink-0 mt-0.5" /> See who's converting</li>
            </ul>
            <div class="card-actions mt-4">
              <a href={ExternalLinks.cal_john()} class="btn btn-outline btn-block">Build it with me</a>
            </div>
          </div>
        </div>
      </div>
      <p class="text-sm text-base-content/50 mt-4">Want it built with you? That's a conversation, not a checkout.</p>
    </div>
  </section>

  <%!-- ───────────── FINAL CTA ───────────── --%>
  <section class="bg-base-200">
    <div class="max-w-6xl mx-auto px-6 py-20 lg:py-28 text-center">
      <h2 class="text-4xl md:text-5xl font-bold tracking-tight max-w-2xl mx-auto">
        You've had the idea long enough.
      </h2>
      <p class="text-lg text-base-content/70 mt-5 max-w-xl mx-auto leading-relaxed">
        Bring the idea. Drive the build yourself, or build it with me — either way, the tools to
        run and grow it are right here.
      </p>
      <div class="mt-8 flex flex-wrap gap-4 justify-center">
        <.link href={~p"/users/register"} class="btn btn-primary btn-lg">Start free</.link>
        <a href={ExternalLinks.cal_john()} class="btn btn-outline btn-lg">Build it with me</a>
      </div>
    </div>
  </section>
</Layouts.marketing>
