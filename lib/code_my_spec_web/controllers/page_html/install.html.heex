<Layouts.marketing current_path={assigns[:current_path]} flash={@flash} current_scope={@current_scope} page_title={@page_title}>
  <%!-- ───────────── HERO (compact) ───────────── --%>
  <section class="bg-base-200 border-b border-base-300">
    <div class="max-w-3xl mx-auto px-6 py-14 lg:py-20 text-center">
      <div class="badge badge-primary badge-outline gap-2 mb-5">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-primary"></span>
        Free forever · bring your own model · no lock-in
      </div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight leading-[1.05]">
        Start building. <span class="text-primary">Free.</span>
      </h1>
      <p class="text-lg text-base-content/70 mt-5 max-w-xl mx-auto leading-relaxed">
        A build harness for your coding agent. It runs on your machine and drives the coding agent
        you already have — Claude Code, Codex, or Antigravity. Two pieces, a few minutes.
      </p>
    </div>
  </section>

  <%!-- ───────────── INSTALL STEPS ───────────── --%>
  <section class="border-b border-base-300">
    <div class="max-w-3xl mx-auto px-6 py-14 lg:py-20 flex flex-col gap-8">
      <%!-- Step 1: server --%>
      <div class="flex gap-4">
        <div class="flex flex-col items-center">
          <span class="badge badge-primary badge-lg font-bold">1</span>
          <span class="flex-1 w-px bg-base-300 mt-2"></span>
        </div>
        <div class="flex-1 min-w-0 pb-2">
          <h2 class="text-xl font-semibold">Install the server</h2>
          <p class="text-sm text-base-content/60 mt-1">
            A local <code class="text-primary">cms</code> process that hosts the tools. Runs in the
            background on <code>localhost:4003</code> and restarts on boot.
          </p>
          <div role="tablist" class="tabs tabs-lift mt-3">
            <%!-- macOS tab --%>
            <input
              type="radio"
              name="install_os"
              role="tab"
              class="tab"
              aria-label="macOS"
              checked
            />
            <div role="tabpanel" class="tab-content border-base-300 bg-base-200 rounded-box p-4">
              <div class="flex flex-col gap-2">
                <div class="flex items-center justify-between">
                  <span class="badge badge-ghost badge-sm">macOS · Apple Silicon</span>
                  <button
                    class="copy-btn btn btn-xs btn-outline btn-primary"
                    data-copy={"brew install Code-My-Spec/tap/codemyspec\nbrew services start codemyspec"}
                    data-event-name="install_command_copy"
                    data-event-harness="codemyspec-server"
                    data-event-location="install_page_macos"
                  >
                    Copy
                  </button>
                </div>
                <div class="mockup-code text-sm w-full">
                  <pre data-prefix="$"><code>brew install Code-My-Spec/tap/codemyspec</code></pre>
                  <pre data-prefix="$"><code>brew services start codemyspec</code></pre>
                </div>
              </div>
            </div>

            <%!-- Windows tab --%>
            <input type="radio" name="install_os" role="tab" class="tab" aria-label="Windows" />
            <div role="tabpanel" class="tab-content border-base-300 bg-base-200 rounded-box p-4">
              <div class="flex flex-col gap-3">
                <div>
                  <div class="flex items-center justify-between">
                    <span class="badge badge-ghost badge-sm">Windows · x64</span>
                  </div>
                  <p class="text-xs text-base-content/60 mt-2">
                    Download <code>cms-setup-x64.msi</code> from the
                    <a href="https://github.com/Code-My-Spec/plugins/releases" class="link link-primary">latest release</a>
                    and run it —
                  </p>
                </div>
                <div class="divider text-xs text-base-content/40 my-0">or, from an elevated PowerShell</div>
                <div class="flex flex-col gap-2">
                  <div class="flex justify-end">
                    <button
                      class="copy-btn btn btn-xs btn-outline btn-primary"
                      data-copy={"iwr -useb https://raw.githubusercontent.com/Code-My-Spec/plugins/main/install.ps1 -OutFile install.ps1; .\\install.ps1"}
                      data-event-name="install_command_copy"
                      data-event-harness="codemyspec-server"
                      data-event-location="install_page_windows"
                    >
                      Copy
                    </button>
                  </div>
                  <div class="mockup-code text-xs w-full min-w-0">
                    <pre data-prefix="&gt;" class="whitespace-pre-wrap break-all pl-8 -indent-8"><code>iwr -useb https://raw.githubusercontent.com/Code-My-Spec/plugins/main/install.ps1 -OutFile install.ps1; .\install.ps1</code></pre>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%!-- Step 2: plugin --%>
      <div class="flex gap-4">
        <div class="flex flex-col items-center">
          <span class="badge badge-primary badge-lg font-bold">2</span>
          <span class="flex-1 w-px bg-base-300 mt-2"></span>
        </div>
        <div class="flex-1 min-w-0 pb-2">
          <h2 class="text-xl font-semibold">Install the plugin</h2>
          <p class="text-sm text-base-content/60 mt-1">
            In your coding agent. Claude Code is the deepest integration; Codex and Antigravity are
            supported too.
          </p>
          <div role="tablist" class="tabs tabs-lift mt-3">
            <%!-- Claude Code tab --%>
            <input
              type="radio"
              name="install_agent"
              role="tab"
              class="tab"
              aria-label="Claude Code"
              checked
            />
            <div role="tabpanel" class="tab-content border-base-300 bg-base-200 rounded-box p-4">
              <.install_card
                harness="codemyspec"
                footer_label="in claude code"
                location="install_page_claude"
              />
            </div>

            <%!-- OpenAI Codex tab --%>
            <input type="radio" name="install_agent" role="tab" class="tab" aria-label="Codex" />
            <div role="tabpanel" class="tab-content border-base-300 bg-base-200 rounded-box p-4">
              <div class="flex flex-col gap-2">
                <div class="flex items-center justify-between">
                  <span class="badge badge-ghost badge-sm">OpenAI Codex · early</span>
                  <button
                    class="copy-btn btn btn-xs btn-outline btn-primary"
                    data-copy="codex plugin marketplace add Code-My-Spec/plugins"
                    data-event-name="install_command_copy"
                    data-event-harness="codemyspec-codex"
                    data-event-location="install_page_codex"
                  >
                    Copy
                  </button>
                </div>
                <div class="mockup-code text-sm w-full min-w-0">
                  <pre data-prefix="$" class="whitespace-pre-wrap break-all"><code>codex plugin marketplace add Code-My-Spec/plugins</code></pre>
                </div>
                <p class="text-xs text-base-content/60">
                  Then install <code>codemyspec</code> from <code>/plugins</code> and enable hooks via
                  <code>/hooks</code>. Latest steps in the
                  <a href="https://github.com/Code-My-Spec/plugins" class="link link-primary">plugin repo</a>.
                </p>
              </div>
            </div>

            <%!-- Google Antigravity tab --%>
            <input type="radio" name="install_agent" role="tab" class="tab" aria-label="Antigravity" />
            <div role="tabpanel" class="tab-content border-base-300 bg-base-200 rounded-box p-4">
              <div class="flex flex-col gap-2">
                <div class="flex items-center justify-between">
                  <span class="badge badge-ghost badge-sm">Google Antigravity · early</span>
                  <button
                    class="copy-btn btn btn-xs btn-outline btn-primary"
                    data-copy="agy plugin install /path/to/codemyspec"
                    data-event-name="install_command_copy"
                    data-event-harness="codemyspec-antigravity"
                    data-event-location="install_page_antigravity"
                  >
                    Copy
                  </button>
                </div>
                <div class="mockup-code text-sm w-full min-w-0">
                  <pre data-prefix="$" class="whitespace-pre-wrap break-all"><code>agy plugin install /path/to/codemyspec</code></pre>
                </div>
                <p class="text-xs text-base-content/60">
                  Or copy the plugin into <code>~/.gemini/config/plugins/codemyspec/</code>. Latest steps
                  in the
                  <a href="https://github.com/Code-My-Spec/plugins" class="link link-primary">plugin repo</a>.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%!-- Step 3: first run --%>
      <div class="flex gap-4">
        <div class="flex flex-col items-center">
          <span class="badge badge-primary badge-lg font-bold">3</span>
        </div>
        <div class="flex-1">
          <h2 class="text-xl font-semibold">First run</h2>
          <p class="text-sm text-base-content/60 mt-1">In your Phoenix project.</p>
          <div class="card bg-base-200 border border-base-300 shadow-sm mt-3">
            <div class="card-body gap-2 p-4">
              <div class="flex items-center justify-between">
                <span class="badge badge-ghost badge-sm">sign in once</span>
                <button
                  class="copy-btn btn btn-xs btn-outline btn-primary"
                  data-copy="/codemyspec:init auth"
                  data-event-name="install_command_copy"
                  data-event-harness="codemyspec-init"
                  data-event-location="install_page_firstrun"
                >
                  Copy
                </button>
              </div>
              <div class="mockup-code text-sm w-full">
                <pre data-prefix="$"><code>/codemyspec:init auth</code></pre>
              </div>
              <p class="text-xs text-base-content/60">
                Then tell the agent to run <code>get_next_requirement</code>. That's the only command
                you need to remember — whenever it doesn't know what's next, that's the answer.
              </p>
              <p class="text-xs text-base-content/50">
                Shown for Claude Code. On Codex, run the <code>init</code> skill from
                <code>/skills</code>; on Antigravity, run <code>/init auth</code>.
              </p>
            </div>
          </div>
          <p class="text-sm text-base-content/60 mt-4">
            Stuck, or want the whole loop explained?
            <.link navigate={~p"/documentation/getting-started"} class="link link-primary">
              Read the getting started guide
            </.link>
            — it covers the setup checklist, the local admin UI, and troubleshooting.
          </p>
        </div>
      </div>

      <p class="text-sm text-base-content/50 border-t border-base-300 pt-6">
        Requirements: macOS (Apple Silicon) or Windows (x64) · a coding agent (Claude Code — deepest;
        Codex or Antigravity — early) · a Phoenix project (Elixir 1.18+, Phoenix 1.8+, PostgreSQL).
      </p>
    </div>
  </section>

  <%!-- ───────────── WHY IT'S FREE ───────────── --%>
  <section class="border-b border-base-300 bg-base-200">
    <div class="max-w-3xl mx-auto px-6 py-12 lg:py-16">
      <.eyebrow name="no catch" />
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight mt-3">Free forever. Here's why we can mean it.</h2>
      <p class="text-base-content/70 mt-4 leading-relaxed">
        We make money when your app is <span class="italic">running</span> — the hosted layer for
        email, chat, and growth that keeps it alive in the world. Not when you build it. Bring your
        own keys, keep your own bill, own your code. No markup, no lock-in.
      </p>
      <div class="mt-5">
        <.link navigate={~p"/developers"} class="link link-primary font-medium">Why this, and not a platform you rent →</.link>
      </div>
    </div>
  </section>

  <%!-- ───────────── STUCK? ───────────── --%>
  <section class="bg-base-200">
    <div class="max-w-3xl mx-auto px-6 py-12 lg:py-16 text-center">
      <p class="text-lg text-base-content/70">
        Want the result without learning the tooling?
      </p>
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight mt-2">Build it with me instead.</h2>
      <div class="mt-6">
        <a href={ExternalLinks.cal_john()} class="btn btn-outline btn-lg" data-event-label="cta-service-inquiry-install">Talk to John</a>
      </div>
    </div>
  </section>
</Layouts.marketing>
