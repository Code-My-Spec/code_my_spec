From ac08d92c4ee7551f18cff67f09b03a9c58aa3e00 Mon Sep 17 00:00:00 2001
From: John Davenport <johns10@gmail.com>
Date: Wed, 14 Oct 2026 11:20:19 -0400
Subject: [PATCH] Replay only the latest cached run for each test file

---
 lib/client_utils/test_formatter/test_cache.ex | 49 +++++-----
 test/test_cache_latest_run_test.exs           | 90 +++++++++++++++++++
 2 files changed, 119 insertions(+), 20 deletions(-)
 create mode 100644 test/test_cache_latest_run_test.exs

diff --git a/lib/client_utils/test_formatter/test_cache.ex b/lib/client_utils/test_formatter/test_cache.ex
index 19bed32..ff50f78 100644
--- a/lib/client_utils/test_formatter/test_cache.ex
+++ b/lib/client_utils/test_formatter/test_cache.ex
@@ -80,36 +80,45 @@ defmodule ClientUtils.TestFormatter.TestCache do
   end
 
   @doc """
-  Gets all events for a file that were recorded after the given time.
+  Gets this file's events from its latest run completed after the given time.
+  A later run supersedes earlier outcomes without suppressing current failures.
   """
   def get_events_for_file(file, after_time) do
-    data = read_events_file()
-    after_timestamp = to_unix(after_time)
-
-    data["runs"]
-    |> Enum.filter(fn run ->
-      run_timestamp = run["completed_at"] |> parse_iso8601() |> to_unix()
-      run_timestamp > after_timestamp
-    end)
-    |> Enum.flat_map(fn run -> run["events"] end)
-    |> Enum.filter(fn %{"file" => f} -> f == file end)
-    |> Enum.map(fn %{"event" => encoded} -> decode_event(encoded) end)
+    after_time
+    |> latest_events_by_file()
+    |> Map.get(file, [])
+    |> decode_events()
   end
 
   @doc """
-  Gets all events from runs completed after the given time.
+  Gets each file's latest run events completed after the given time.
+  Running one file again does not discard other files' latest results.
   """
   def get_events_after(after_time) do
-    data = read_events_file()
+    after_time
+    |> latest_events_by_file()
+    |> Enum.sort_by(fn {file, _events} -> file end)
+    |> Enum.flat_map(fn {_file, events} -> events end)
+    |> decode_events()
+  end
+
+  defp latest_events_by_file(after_time) do
     after_timestamp = to_unix(after_time)
 
-    data["runs"]
-    |> Enum.filter(fn run ->
-      run_timestamp = run["completed_at"] |> parse_iso8601() |> to_unix()
-      run_timestamp > after_timestamp
+    read_events_file()["runs"]
+    |> Enum.with_index()
+    |> Enum.map(fn {run, index} ->
+      {run, run["completed_at"] |> parse_iso8601() |> to_unix(), index}
     end)
-    |> Enum.flat_map(fn run -> run["events"] end)
-    |> Enum.map(fn %{"event" => encoded} -> decode_event(encoded) end)
+    |> Enum.filter(fn {_run, timestamp, _index} -> timestamp > after_timestamp end)
+    |> Enum.sort_by(fn {_run, timestamp, index} -> {timestamp, index} end)
+    |> Enum.reduce(%{}, fn {run, _timestamp, _index}, files ->
+      Map.merge(files, Enum.group_by(run["events"], & &1["file"]))
+    end)
+  end
+
+  defp decode_events(events) do
+    Enum.map(events, fn %{"event" => encoded} -> decode_event(encoded) end)
   end
 
   @doc """
diff --git a/test/test_cache_latest_run_test.exs b/test/test_cache_latest_run_test.exs
new file mode 100644
index 0000000..2f3be85
--- /dev/null
+++ b/test/test_cache_latest_run_test.exs
@@ -0,0 +1,90 @@
+defmodule ClientUtils.TestFormatter.TestCacheLatestRunTest do
+  use ExUnit.Case, async: false
+
+  alias ClientUtils.TestFormatter.TestCache
+
+  setup do
+    previous = System.get_env("AGENT_TEST_EVENTS_FILE")
+    dir = Path.join(System.tmp_dir!(), "latest-cache-#{System.unique_integer([:positive])}")
+    File.mkdir_p!(dir)
+    System.put_env("AGENT_TEST_EVENTS_FILE", Path.join(dir, "events.json"))
+
+    on_exit(fn ->
+      restore_environment(previous)
+      File.rm_rf!(dir)
+    end)
+
+    %{cutoff: ~U[2026-01-01 00:00:00Z]}
+  end
+
+  defp restore_environment(nil), do: System.delete_env("AGENT_TEST_EVENTS_FILE")
+  defp restore_environment(value), do: System.put_env("AGENT_TEST_EVENTS_FILE", value)
+
+  defp event(file, state),
+    do: {:test_finished, %{name: :example, tags: %{file: file}, state: state}}
+
+  test "a later pass replaces the failure in both replay readers", %{cutoff: cutoff} do
+    failure = event("/a.exs", {:failed, []})
+    pass = event("/a.exs", nil)
+    TestCache.store_events([failure], [], DateTime.add(cutoff, 1, :second))
+    TestCache.store_events([pass], [], DateTime.add(cutoff, 2, :second))
+
+    assert TestCache.get_events_for_file("/a.exs", cutoff) == [pass]
+    assert TestCache.get_events_after(cutoff) == [pass]
+    assert TestCache.file_tested_after?("/a.exs", cutoff)
+  end
+
+  test "a later failure replaces a pass and keeps the complete run sequence", %{cutoff: cutoff} do
+    pass = event("/a.exs", nil)
+
+    latest = [
+      {:test_started, %{tags: %{file: "/a.exs"}}},
+      event("/a.exs", {:failed, []}),
+      {:module_finished, %{file: "/a.exs"}}
+    ]
+
+    TestCache.store_events([pass], [], DateTime.add(cutoff, 1, :second))
+    TestCache.store_events(latest, [], DateTime.add(cutoff, 2, :second))
+
+    assert TestCache.get_events_for_file("/a.exs", cutoff) == latest
+    assert TestCache.get_events_after(cutoff) == latest
+  end
+
+  test "rerunning one file preserves another file's failure", %{cutoff: cutoff} do
+    first = event("/a.exs", {:failed, []})
+    other = event("/b.exs", {:failed, []})
+    pass = event("/a.exs", nil)
+    TestCache.store_events([first, other], [], DateTime.add(cutoff, 1, :second))
+    TestCache.store_events([pass], [], DateTime.add(cutoff, 2, :second))
+
+    assert TestCache.get_events_after(cutoff) == [pass, other]
+    assert TestCache.get_events_for_file("/b.exs", cutoff) == [other]
+  end
+
+  test "completion time wins over insertion order", %{cutoff: cutoff} do
+    pass = event("/a.exs", nil)
+    failure = event("/a.exs", {:failed, []})
+    TestCache.store_events([pass], [], DateTime.add(cutoff, 2, :second))
+    TestCache.store_events([failure], [], DateTime.add(cutoff, 1, :second))
+
+    assert TestCache.get_events_for_file("/a.exs", cutoff) == [pass]
+  end
+
+  test "equal timestamps use the last appended run", %{cutoff: cutoff} do
+    completed = DateTime.add(cutoff, 1, :second)
+    pass = event("/a.exs", nil)
+    TestCache.store_events([event("/a.exs", {:failed, []})], [], completed)
+    TestCache.store_events([pass], [], completed)
+
+    assert TestCache.get_events_for_file("/a.exs", cutoff) == [pass]
+  end
+
+  test "the cutoff remains exclusive and absent files remain uncovered", %{cutoff: cutoff} do
+    TestCache.store_events([event("/a.exs", nil)], [], cutoff)
+
+    assert TestCache.get_events_for_file("/a.exs", cutoff) == []
+    assert TestCache.get_events_after(cutoff) == []
+    refute TestCache.file_tested_after?("/a.exs", cutoff)
+    refute TestCache.file_tested_after?("/missing.exs", cutoff)
+  end
+end
