{
  "mcpServers": {
    "semble": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "semble[mcp]",
        "semble"
      ],
      "env": {}
    },
    "vibium": {
      "type": "stdio",
      "command": "node",
      "args": ["${CLAUDE_PROJECT_DIR}/plugins/claude/.claude-plugin/bin/vibium-mcp.js", "mcp"]
    }
  }
}