[debug] Processing with CmsHarness.Web.HooksController.handle/2
  Parameters: %{"cwd" => "/Users/johndavenport/Documents/github/code_my_spec/.claude/worktrees/phx-new-generator", "effort" => %{"level" => "xhigh"}, "harness_id" => "6bc4851f-f735-4590-bb1c-c660619b4019", "hook_event_name" => "PreToolUse", "permission_mode" => "auto", "prompt_id" => "18333283-bce2-4dca-9e77-8daf87f10025", "session_id" => "80dcd471-007d-4438-8f86-f511c41e6e37", "tool_input" => %{"content" => "p = \"lib/code_my_spec/migration.ex\"\ns = open(p).read()\n\n# 1. stories: carry the epic on a recognised row too\ns = s.replace(\n    \"          relink(scope, already, components, story)\",\n    \"          relink(scope, already, components, epics, story)\",\n    1,\n)\n\ns = s.replace(\n    \"  defp relink(scope, story, components, payload) do\\n\"\n    \"    story\\n\"\n    \"    |> resync_attrs(components, payload)\",\n    \"  defp relink(scope, story, components, epics, payload) do\\n\"\n    \"    story\\n\"\n    \"    |> resync_attrs(components, epics, payload)\",\n    1,\n)\n\nold_attrs = '''  defp resync_attrs(story, components, payload) do\n    %{}\n    |> put_changed(\n      story,\n      :component_id,\n      Map.get(components, payload[\"component_module_name\"] || :none)\n    )'''\nnew_attrs = '''  defp resync_attrs(story, components, epics, payload) do\n    epic = epics[payload[\"epic_local_id\"]]\n\n    %{}\n    |> put_changed(\n      story,\n      :component_id,\n      Map.get(components, payload[\"component_module_name\"] || :none)\n    )\n    |> put_changed(story, :epic_id, epic && epic.id)'''\nassert old_attrs in s, \"resync_attrs anchor\"\ns = s.replace(old_attrs, new_attrs, 1)\n\n# 2. criteria: a recognised criterion still takes its kind\nold_crit = '''  defp reuse_or_create_criterion(%{} = already, _scope, _story, _criterion, _rules),\n    do: {:ok, already}'''\nnew_crit = '''  # A criterion already here still takes its kind. Matching one and returning it\n  # untouched left 912 of them without the field the moment it started being\n  # exported — the same way stories stayed parked and nine links stayed stale.\n  defp reuse_or_create_criterion(%{} = already, scope, _story, criterion, _rules) do\n    resync(\n      already,\n      criterion,\n      [:kind, :verified, :verified_at],\n      &AcceptanceCriteria.update_criterion(scope, &1, &2)\n    )\n  end'''\nassert old_crit in s, \"criterion reuse anchor\"\ns = s.replace(old_crit, new_crit, 1)\n\nopen(p, \"w\").write(s)\nprint(\"epic and kind now resync\")\n", "file_path" => "/private/tmp/claude-501/-Users-johndavenport-Documents-github-code-my-spec--claude-worktrees-phx-new-generator/80dcd471-007d-4438-8f86-f511c41e6e37/scratchpad/fix_resync.py"}, "tool_name" => "Write", "tool_use_id" => "toolu_01VPtUnVmEaEXRbV2pdnmTQL", "transcript_path" => "/Users/johndavenport/.claude/projects/-Users-johndavenport-Documents-github-code-my-spec--claude-worktrees-phx-new-generator/80dcd471-007d-4438-8f86-f511c41e6e37.jsonl"}
