  alias CmsHarness.Projects\n  alias CmsHarness.Token\n\n  @doc \"\"\"\n  The directory this id names, or `:unknown`.\n\n  Running subtrees first, then the server. `:unknown` covers both \"no such\n  harness\" and \"the server cannot say\", because the harness's answer is the\n  same either way: it will not guess.\n  \"\"\"\n  @spec root(String.t()) :: {:ok, String.t()} | :unknown\n  def root(harness_id) when is_binary(harness_id) and harness_id != \"\" do\n    case running(harness_id) do\n      {:ok, root} -> {:ok, root}\n      :unknown -> ask_server(harness_id)\n    end\n  end\n\n  def root(_), do: :unknown\n\n  @doc \"Every working copy this harness is currently serving, as `id => root`.\"\n  @spec all() :: %{String.t() => String.t()}\n  def all do\n    Projects.list()\n    |> Enum.flat_map(fn root ->\n      case identity(root) do\n        nil -> []\n        id -> [{id, root}]\n      end\n    end)\n    |> Map.new()\n  end\n\n  defp running(harness_id) do\n    Projects.list()\n    |> Enum.find(&(identity(&1) == harness_id))\n    |> case do\n      nil -> :unknown\n      root -> {:ok, root}\n    end\n  end\n\n  defp identity(root) do\n    case HarnessIdentity.read(root) do\n      {:ok, id} -> id\n      _ -> nil\n    end\n  end\n\n  defp ask_server(harness_id) do\n    with {:ok, token} <- Token.access_token(),\n         {:ok, %{status: 200, body: body}} <- get(harness_id, token) do\n      from_body(harness_id, body)\n    else\n      {:ok, %{status: 404}} ->\n        Logger.warning(\"[CmsHarness] the server does not know harness \#{harness_id}\")\n        :unknown\n\n      other ->\n        Logger.warning(\n          \"[CmsHarness] could not ask the server where harness \#{harness_id} is: \#{inspect(other)}\"\n        )\n\n        :unknown\n    end\n  end\n\n  defp get(harness_id, token) do\n    Req.get(\n      url: Config.server_url() |> String.trim_trailing(\"/\") |> Kernel.<>(\"/api/harnesses/\#{harness_id}\"),\n      headers: [{\"authorization\", \"Bearer \" <> token}],\n      retry: false,\n      receive_timeout: to_timeout(second: 10)\n    )\n  end\n\n  # A harness the server knows but has no root for has never reported one — it\n  # was issued an id and never joined. Nothing to serve, and saying so beats\n  # serving a directory that was guessed.\n  defp from_body(harness_id, %{\"root\" => root}) when is_binary(root) and root != \"\",\n    do: {:ok, root}\n\n  defp from_body(harness_id, _body) do\n    Logger.warning(\"[CmsHarness] harness \#{harness_id} has not reported where it is\")\n    :unknown\n  end\nend\n", "file_path" => "/Users/johndavenport/Documents/github/code_my_spec/.claude/worktrees/phx-new-generator/lib/cms_harness/working_copies.ex"}, "tool_name" => "Write", "tool_response" => %{"content" => "defmodule CmsHarness.WorkingCopies do\n  @moduledoc \"\"\"\n  Which working copy a harness id names.\n\n  A hook arrives addressed to an id. Turning that into a directory is this\n  module's whole job, and it does it by asking the server.\n\n  ## Why the server\n\n  Harness records belong there. Keeping a copy on the harness — a file, a\n  table, a list of directories in the environment — is a second source of truth\n  that has to be reconciled, and it puts the operator back in the business of\n  telling the harness about directories, which is the thing being removed. It\n  also cannot work: a sprite runs standalone with no database to hold such a\n  copy.\n\n  Needing the server costs nothing that was not already spent. Every hook\n  decision is the server's; a harness that cannot reach it cannot answer a hook\n  whatever it knows about directories.\n\n  ## Copies already running answer without a round trip\n\n  A subtree that is serving knows its own root, and its id is the file in it.\n  That is checked first — it covers every hook after the first — so the lookup\n  is one call per working copy per harness lifetime, not one per hook.\n\n  ## An unknown id is refused\n\n  Not resolved to something nearby. What this