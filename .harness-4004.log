  Parameters: %{"cwd" => "/Users/johndavenport/Documents/github/code_my_spec/.claude/worktrees/phx-new-generator", "duration_ms" => 28, "effort" => %{"level" => "xhigh"}, "harness_id" => "6bc4851f-f735-4590-bb1c-c660619b4019", "hook_event_name" => "PostToolUse", "permission_mode" => "auto", "prompt_id" => "39150913-9d7c-48ec-b910-e10e2210de14", "session_id" => "80dcd471-007d-4438-8f86-f511c41e6e37", "tool_input" => %{"command" => "sed -n '199,235p' lib/code_my_spec/migration.ex", "description" => "Read put_stories and project_stories"}, "tool_name" => "Bash", "tool_response" => %{"interrupted" => false, "isImage" => false, "noOutputExpected" => false, "stderr" => "", "stdout" => "    existing = Epics.list_epics(scope)\n\n    collect(epics, fn epic ->\n      case Enum.find(existing, &(&1.name == epic[\"name\"])) do\n        %{} = already -> {:ok, already}\n        nil -> Epics.create_epic(scope, attrs(epic, Epics.Epic))\n      end\n    end)\n  end\n\n  defp put_stories(scope, stories, epics) do\n    existing = scope |> project_stories() |> Map.new(&{&1.title, &1})\n    components = component_ids_by_module(scope)\n\n    collect(stories, fn story ->\n      case existing[story[\"title\"]] do\n        %{} = already ->\n          {:ok, already}\n\n        nil ->\n          story\n          |> attrs(Stories.Story)\n          |> put_ref(:epic_id, epics[story[\"epic_local_id\"]])\n          |> put_component(components, story[\"component_module_name\"])\n          |> then(&Stories.create_story(scope, &1))\n      end\n    end)\n  end\n\n  # A component this deployment does not have yet is left unlinked rather than\n  # invented. Components are synced from files, so the missing one either\n  # arrives with the next scan — and the story can be linked then — or it never\n  # existed here, and a component conjured from a name would be a fiction the\n  # requirement graph would then compute against.\n  defp put_component(attrs, _components, nil), do: attrs\n\n  defp put_component(attrs, components, module_name),"}, "tool_use_id" => "toolu_01LbieM7dDChMoJNZcxWddEi", "transcript_path" => "/Users/johndavenport/.claude/projects/-Users-johndavenport-Documents-github-code-my-spec--claude-worktrees-phx-new-generator/80dcd471-007d-4438-8f86-f511c41e6e37.jsonl"}
