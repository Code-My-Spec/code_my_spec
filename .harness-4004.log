fused — not resolved to something nearby.\n  \"\"\"\n\n  alias CmsHarness.HarnessConfig\n  alias CmsHarness.Projects\n\n  @doc \"\"\"\n  The directory this id names, or `:unknown`.\n\n  Copies already being served answer first — that is every hook after the\n  first. Otherwise the harness's own working copy is consulted, which is what\n  answers the first one.\n  \"\"\"\n  @spec root(String.t()) :: {:ok, String.t()} | :unknown\n  def root(harness_id) when is_binary(harness_id) and harness_id != \"\" do\n    case Enum.find(known(), fn {id, _root} -> id == harness_id end) do\n      {_id, root} -> {:ok, root}\n      nil -> :unknown\n    end\n  end\n\n  def root(_), do: :unknown\n\n  @doc \"\"\"\n  Every working copy this harness can answer for, as `id => root`.\n\n  The copies it is serving, plus the one it was started in — which is the same\n  set once the first hook has arrived, and differs only before it.\n  \"\"\"\n  @spec all() :: %{String.t() => String.t()}\n  def all, do: Map.new(known())\n\n  defp known do\n    [File.cwd!() | Projects.list()]\n    |> Enum.uniq()\n    |> Enum.flat_map(&entry/1)\n  end\n\n  defp entry(root) do\n    case HarnessConfig.read(root) do\n      {:ok, %{harness_id: id, root: configured}} -> [{id, configured || root}]\n      _ -> []\n    end\n  end\nend\n", "filePath" => "/Users/johndavenport/Documents/github/code_my_spec/.claude/worktrees/phx-new-generator/lib/cms_harness/working_copies.ex", "originalFile" => "defmodule CmsHarness.WorkingCopies do\n  @moduledoc \"\"\"\n  Which working copy a harness id names.\n\n  A hook arrives addressed to an id. Turning that into a directory is this\n  module's whole job, and it does it by asking the server.\n\n  ## Why the server\n\n  Harness records belong there. Keeping a copy on the harness — a file, a\n  table, a list of directories in the environment — is a second source of truth\n  that has to be reconciled, and it puts the operator back in the business of\n  telling the harness about directories, which is the thing being removed. It\n  also cannot work: a sprite runs standalone with no database to hold such a\n  copy.\n\n  Needing the server costs nothing that was not already spent. Every hook\n  decision is the server's; a harness that cannot reach it cannot answer a hook\n  whatever it knows about directories.\n\n  ## Copies already running answer without a round trip\n\n  A subtree that is serving knows its own root, and its id is the file in it.\n  That is checked first — it covers every hook after the first — so the lookup\n  is one call per working copy per harness lifetime, not one per hook.\n\n  ## An unknown id is refused\n\n  Not resolved to something nearby. What this replaces walked up from whatever\n  directory the hook fired in until it found a `mix.exs`, so an unonboarded\n  copy silently adopted whichever project sat above it, and two copies of one\n  project could not be told apart at all.\n  \"\"\"\n\n  require Logger\n\n  alias CmsHarness.Config\n  alias CmsHarness.HarnessIdentity\n  alias CmsHarness.Projects\n  alias CmsHarness.Token\n\n  @doc \"\"\"\n  The directory this id names, or `:unknown`.\n\n  Running subtrees first, then the server. `:unknown` covers both \"no such\n  harness\" and \"the server cannot say\", because the harness's answer is the\n  same either way: it will not guess.\n  \"\"\"\n  @spec root(String.t()) :: {:ok, String.t()} | :unknown\n  def root(harness_id) when is_binary(harness_id) and harness_id != \"\" do\n    case running(harness_id) do\n      {:ok, root} -> {:ok, root}\n      :unknown -> ask_server(harness_id)\n    end\n  end\n\n  def root(_), do: :unknown\n\n  @doc \"Every working copy this harness is currently serving, as `id => root`.\"\n  @spec all() :: %{String.t() => String.t()}\n  def all do\n    Projects.list()\n    |> Enum.flat_map(fn root ->\n      case identity(root) do\n        nil -> []\n        id -> [{id, root}]\n      end\n    end)\n    |> Map.new()\n  end\n\n  defp running(harness_id) do\n    Project (truncated)
