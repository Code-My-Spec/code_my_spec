  Parameters: %{"cwd" => "/Users/johndavenport/Documents/github/code_my_spec/.claude/worktrees/phx-new-generator", "duration_ms" => 17, "effort" => %{"level" => "xhigh"}, "harness_id" => "6bc4851f-f735-4590-bb1c-c660619b4019", "hook_event_name" => "PostToolUse", "permission_mode" => "auto", "prompt_id" => "27cbd0ed-fd13-4fd9-aa8f-00106c6fc4d5", "session_id" => "80dcd471-007d-4438-8f86-f511c41e6e37", "tool_input" => %{"command" => "sed -n '126,165p' lib/code_my_spec_local_web/application.ex", "description" => "Read how the migrate command is invoked"}, "tool_name" => "Bash", "tool_response" => %{"interrupted" => false, "isImage" => false, "noOutputExpected" => false, "stderr" => "", "stdout" => "    \"migrate\" in Enum.reject(argv, &(&1 in [\"--\", \"\"])) or\n      System.get_env(\"CMS_MIGRATE\") in [\"1\", \"true\"]\n  end\n\n  defp start_migrate(argv) do\n    ensure_directories()\n\n    children = [\n      CodeMySpec.Vault,\n      CodeMySpec.Repo,\n      CodeMySpec.Environments.registry_child_spec(),\n      CodeMySpecLocalWeb.Migrator\n    ]\n\n    {:ok, pid} =\n      Supervisor.start_link(children, strategy: :one_for_one, name: CodeMySpec.Supervisor)\n\n    argv |> run_migration() |> report_migration()\n\n    {:ok, pid}\n  end\n\n  defp run_migration(argv) do\n    with {:ok, cloud_project_id} <- migrate_target(argv),\n         working_dir = File.cwd!(),\n         {:ok, project} <- CodeMySpec.Projects.resolve_local_project(working_dir),\n         {:ok, scope} <- Scope.for_local_project(project, working_dir) do\n      IO.puts(\"Migrating \#{project.name} to cloud project \#{cloud_project_id}…\")\n      Migration.Client.migrate(scope, cloud_project_id: cloud_project_id)\n    end\n  end\n\n  # `--project <id>` names the cloud project to fill. It is deliberately not\n  # inferred: the local project's id means nothing on the server, and guessing\n  # by name could pour one project's work into another's.\n  defp migrate_target(argv) do\n    case Enum.drop_while(argv, &(&1 != \"--project\")) do\n      [\"--project\", id | _] when id != \"\" -> {:ok, id}\n      _ -> project_id_from_env()\n    end"}, "tool_use_id" => "toolu_015ddG6NRmJ8xii7P8b1B3VL", "transcript_path" => "/Users/johndavenport/.claude/projects/-Users-johndavenport-Documents-github-code-my-spec--claude-worktrees-phx-new-generator/80dcd471-007d-4438-8f86-f511c41e6e37.jsonl"}
