  Parameters: %{"cwd" => "/Users/johndavenport/Documents/github/code_my_spec/.claude/worktrees/phx-new-generator", "duration_ms" => 113711, "effort" => %{"level" => "xhigh"}, "harness_id" => "6bc4851f-f735-4590-bb1c-c660619b4019", "hook_event_name" => "PostToolUse", "permission_mode" => "auto", "prompt_id" => "804862e4-b95d-4752-9335-34f3a3ca18d8", "session_id" => "80dcd471-007d-4438-8f86-f511c41e6e37", "tool_input" => %{"command" => "elixir -S mix test test/cms_harness/ 2>&1 | grep -E \"^\\s+\\d+\\) test|Finished|tests,\" | head -12", "description" => "Re-run the harness suite", "timeout" => 420000}, "tool_name" => "Bash", "tool_response" => %{"interrupted" => false, "isImage" => false, "noOutputExpected" => false, "stderr" => "", "stdout" => "  1) test an empty decision means nothing to say, not something unreadable (CmsHarness.Web.HooksControllerTest)\n  2) test serving a project a hook for an unknown directory starts serving it (CmsHarness.Web.HooksControllerTest)\n  3) test an empty decision post-tool-use is not refused on every tool call (CmsHarness.Web.HooksControllerTest)\n  4) test a result the server rejects is reported loudly, not swallowed (CmsHarness.AnalysisPathTest)\n  5) test a second run of a source already in flight is refused, and the refusal is sent (CmsHarness.AnalysisPathTest)\n  6) test a run for an analyzer that cannot run is answered, not dropped (CmsHarness.AnalysisPathTest)\n  7) test refusing an id this harness does not serve names the id (CmsHarness.Web.McpControllerTest)\n  8) test hook decisions with no channel at all it is not_connected, which reads differently (CmsHarness.SyncPathTest)\n  9) test joining the harness joins its project's topic and takes the read model (CmsHarness.SyncPathTest)\n 10) test the empty manifest a scan that found nothing is not sent (CmsHarness.SyncPathTest)\n 11) test the watcher follows the connection reconnecting rescans, so the gap does not have to be remembered (CmsHarness.SyncPathTest)\n 12) test joining a project another harness holds is not served (CmsHarness.SyncPathTest)"}, "tool_use_id" => "toolu_01GTdh3A9G2fGv19RESDmWRE", "transcript_path" => "/Users/johndavenport/.claude/projects/-Users-johndavenport-Documents-github-code-my-spec--claude-worktrees-phx-new-generator/80dcd471-007d-4438-8f86-f511c41e6e37.jsonl"}
