  Parameters: %{"cwd" => "/Users/johndavenport/Documents/github/code_my_spec/.claude/worktrees/phx-new-generator", "duration_ms" => 34, "effort" => %{"level" => "xhigh"}, "harness_id" => "6bc4851f-f735-4590-bb1c-c660619b4019", "hook_event_name" => "PostToolUse", "permission_mode" => "auto", "prompt_id" => "3a7a5e8a-b1cb-4155-a6f2-087be6efc8a0", "session_id" => "80dcd471-007d-4438-8f86-f511c41e6e37", "tool_input" => %{"command" => "sed -n '55,110p' test/support/cms_harness_fake_upstream.ex 2>/dev/null || find test -name \"*fake_upstream*\" -exec sed -n '55,110p' {} \\;", "description" => "Read the FakeUpstream plug"}, "tool_name" => "Bash", "tool_response" => %{"interrupted" => false, "isImage" => false, "noOutputExpected" => false, "stderr" => "", "stdout" => "  @spec last_request() ::\n          %{method: String.t(), path: String.t(), headers: map(), body: binary()} | nil\n  def last_request, do: :persistent_term.get({__MODULE__, :request}, nil)\n\n  @doc \"\"\"\n  The last request to `path`, or nil.\n\n  For flows that make more than one call here — the permission proxy raises the\n  request over HTTP and then opens a websocket, and `last_request/0` would hand\n  back the socket upgrade.\n  \"\"\"\n  @spec last_request_to(String.t()) :: map() | nil\n  def last_request_to(path) do\n    {__MODULE__, :requests}\n    |> :persistent_term.get([])\n    |> Enum.filter(&(&1.path == path))\n    |> List.last()\n  end\n\n  @impl Plug\n  def init(opts), do: opts\n\n  @impl Plug\n  def call(conn, _opts) do\n    {:ok, body, conn} = read_body(conn)\n\n    request = %{\n      method: conn.method,\n      path: conn.request_path,\n      headers: Map.new(conn.req_headers),\n      body: body\n    }\n\n    :persistent_term.put({__MODULE__, :request}, request)\n\n    :persistent_term.put(\n      {__MODULE__, :requests},\n      :persistent_term.get({__MODULE__, :requests}, []) ++ [request]\n    )\n\n    # The token exchange is its own route with its own answer, so a test can\n    # assert what the proxy forwarded without that assertion being about the\n    # exchange that had to happen first.\n    if conn.request_path == \"/api/sprite/token\" do\n      :persistent_term.put({__MODULE__, :exchange}, request)\n      respond_to_exchange(conn)\n    else\n      respond(conn, response())\n    end\n  end\n\n  @doc \"What the last token exchange looked like, or nil.\"\n  @spec last_exchange() :: map() | nil\n  def last_exchange, do: :persistent_term.get({__MODULE__, :exchange}, nil)\n\n  @doc \"How the token exchange should answer: `:ok`, or a status to refuse with.\""}, "tool_use_id" => "toolu_019thdMEiCXttJ6AiuMJpFwF", "transcript_path" => "/Users/johndavenport/.claude/projects/-Users-johndavenport-Documents-github-code-my-spec--claude-worktrees-phx-new-generator/80dcd471-007d-4438-8f86-f511c41e6e37.jsonl"}
