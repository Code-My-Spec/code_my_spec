n |> put_status(422) |> json(%{error: \"Could not issue: \#{inspect(reason)}\"})\n    end\n  end\n\n  defp issue(project, params) do\n    scope = %Scope{active_project_id: project.id, active_project: project}\n\n    Harnesses.issue(scope, params[\"harness_id\"], label: params[\"label\"])\n  end\n\n  defp fetch_project(project_id) do\n    case Projects.get_project_by_id(project_id) do\n      nil -> {:error, :no_project}\n      project -> {:ok, project}\n    end\n  end\n\n  defp require_param(params, key) do\n    case params[key] do\n      value when is_binary(value) and value != \"\" -> {:ok, value}\n      _ -> {:error, {:missing, key}}\n    end\n  end\n\n  def show(conn, %{\"id\" => id}) do", "old_string" => "  alias CodeMySpec.Harnesses\n\n  def show(conn, %{\"id\" => id}) do", "replace_all" => false}, "tool_name" => "Edit", "tool_use_id" => "toolu_01Q4JaDXxuX4u7ywP9ujNB3T", "transcript_path" => "/Users/johndavenport/.claude/projects/-Users-johndavenport-Documents-github-code-my-spec--claude-worktrees-phx-new-generator/80dcd471-007d-4438-8f86-f511c41e6e37.jsonl"}
