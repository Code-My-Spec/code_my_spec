ed before it can be observed.", "permission_mode" => "auto", "prompt_id" => "a110438a-307c-469f-9e1a-6f21de42f086", "session_crons" => [], "session_id" => "80dcd471-007d-4438-8f86-f511c41e6e37", "stop_hook_active" => false, "transcript_path" => "/Users/johndavenport/.claude/projects/-Users-johndavenport-Documents-github-code-my-spec--claude-worktrees-phx-new-generator/80dcd471-007d-4438-8f86-f511c41e6e37.jsonl"}
