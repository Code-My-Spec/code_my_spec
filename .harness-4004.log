[debug] Processing with CmsHarness.Web.HooksController.handle/2
  Parameters: %{"cwd" => "/Users/johndavenport/Documents/github/code_my_spec/.claude/worktrees/phx-new-generator", "effort" => %{"level" => "xhigh"}, "harness_id" => "6bc4851f-f735-4590-bb1c-c660619b4019", "hook_event_name" => "PreToolUse", "permission_mode" => "auto", "prompt_id" => "a0ba002e-cead-431e-9d54-ce5a335f64e4", "session_id" => "80dcd471-007d-4438-8f86-f511c41e6e37", "tool_input" => %{"file_path" => "/Users/johndavenport/Documents/github/code_my_spec/.claude/worktrees/phx-new-generator/lib/cms_harness/project/channel_client.ex", "new_string" => "    socket =\n      socket\n      |> assign(:joined, false)\n      |> pause_watcher()\n      |> fail_pending(:not_connected)\n\n    # Always reschedule, `refused` or not. This used to return here when the\n    # flag was set, which made a refusal followed by a disconnect permanent: the\n    # refusal path reschedules, but a socket that then drops landed here and\n    # scheduled nothing, so the subtree sat refusing every hook with \"the server\n    # is answering but this harness cannot hold a socket to it\" until somebody\n    # restarted the process. Two subtrees in one harness went through the same\n    # server restart and only the one that had never been refused came back.\n    #\n    # Nothing about a refusal makes reconnecting wrong — it means another\n    # process holds `_build`, which it releases when it exits, so waiting and\n    # retrying is the whole correct response. `:refused` is for the health\n    # endpoint to say *why* nothing is being served.\n    Process.send_after(self(), :reconnect, delay)\n    {:ok, update(socket, :attempts, &(&1 + 1))}\n  end", "old_string" => "    socket =\n      socket\n      |> assign(:joined, false)\n      |> pause_watcher()\n      |> fail_pending(:not_connected)\n\n    if socket.assigns.refused do\n      {:ok, socket}\n    else\n      Process.send_after(self(), :reconnect, delay)\n      {:ok, update(socket, :attempts, &(&1 + 1))}\n    end\n  end", "replace_all" => false}, "tool_name" => "Edit", "tool_use_id" => "toolu_01NYsLyeyKEibadQCApDR5TU", "transcript_path" => "/Users/johndavenport/.claude/projects/-Users-johndavenport-Documents-github-code-my-spec--claude-worktrees-phx-new-generator/80dcd471-007d-4438-8f86-f511c41e6e37.jsonl"}
