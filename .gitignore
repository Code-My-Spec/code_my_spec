# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/
/screenshots/tmp/

# Ignore package tarball (built via "mix hex.build").
code_my_spec-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

.DS_Store

/test_repos/
/envs
vpn.conf

/priv/plts/*.plt
/priv/plts/*.plt.hash
.elixir_ls
/burrito_out/
.expert/
# Old docs submodule location (now at .code_my_spec/)
/docs/
# Release output (generated by mix release)
/release/
diagnostics.jsonl

# Local CLI dev database
/priv/repo/cli_dev.db

# Digested/gzipped build artifacts (mix phx.digest output)
/priv/static/**/*.gz
/priv/static/manifest-*.json
/priv/static/robots-*.txt
/priv/static/sw-*.js
/priv/static/local/assets/css/local_app-*.css
/priv/static/local/assets/js/*-*.js

# CodeMySpec - ephemeral
.code_my_spec/internal/

# Built binary (distributed via GitHub Releases, not git)
/plugins/claude/bin/cms
/plugins/claude/bin/cms.exe
artifacts/

# Dynamically generated test cassettes (rewritten per test run)
test/cassettes/oauth/google_login_new_user.json
.claude/scheduled_tasks.lock

# Local environment variables (API keys, secrets)
.env
.env.local


# CI-staged binaries for MSI build (not committed)
installers/windows/cms.exe
installers/windows/shawl.exe
installers/windows/*.msi
/priv/chromedriver/
relay/cms-mcp-relay

# This working copy's harness identity — issued by the server, per checkout.
# Never committed: a committed id is cloned into every checkout, so a sprite
# would come up wearing the laptop's identity and both would sync into the
# same rows.
.cms_harness_id
