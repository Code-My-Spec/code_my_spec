# Project-scoped environment for code_my_spec.
# `direnv allow` once after cloning; direnv exports these only while
# the shell is cwd'd into this tree.

# Claude Code agent teams (experimental).
# https://code.claude.com/docs/en/agent-teams
# Enables direct teammate-to-teammate SendMessage between spawned
# sub-agents instead of report-back-to-main only. Story 810's
# SendMessage-aware dispatch contract depends on this flag.
export CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1
