              "30",
              "-X",
              "POST",
              "http://localhost:4004/api/hooks/post-tool-use",
              "-H",
              "Content-Type: application/json",
              "-H",
              "X-Harness-Id: ${CMS_HARNESS_ID}",
              "--data-binary",
              "@-"
            ]
          }
        ]
      }
    ],
    "Stop": [
