        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-sS",
              "-X",
              "POST",
              "http://localhost:4004/api/permissions/request",
              "-H",
              "Content-Type: application/json",
              "-H",
              "X-Harness-Id: ${CMS_HARNESS_ID}",
              "--data-binary",
              "@-"
            ]
          }
        ]
      }
    ]
  }
