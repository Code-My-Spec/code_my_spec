              "POST",
              "http://localhost:4004/api/hooks/stop",
              "-H",
              "Content-Type: application/json",
              "-H",
              "X-Harness-Id: ${CMS_HARNESS_ID}",
              "--data-binary",
              "@-"
            ]
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-sS",
              "--max-time",
              "30",
              "-X",
              "POST",
              "http://localhost:4004/api/hooks/subagent-start",
              "-H",
              "Content-Type: application/json",
              "-H",
              "X-Harness-Id: ${CMS_HARNESS_ID}",
              "--data-binary",
              "@-"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-sS",
              "--max-time",
              "30",
              "-X",
