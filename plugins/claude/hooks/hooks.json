{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/.claude-plugin/bin/hook",
              "/api/hooks/session-start"
            ],
            "commandWindows": "\"%CLAUDE_PLUGIN_ROOT%\\.claude-plugin\\bin\\hook.cmd\" /api/hooks/session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/.claude-plugin/bin/hook",
              "/api/hooks/pre-tool-use"
            ],
            "commandWindows": "\"%CLAUDE_PLUGIN_ROOT%\\.claude-plugin\\bin\\hook.cmd\" /api/hooks/pre-tool-use"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/.claude-plugin/bin/hook",
              "/api/hooks/ask-user-question"
            ],
            "commandWindows": "\"%CLAUDE_PLUGIN_ROOT%\\.claude-plugin\\bin\\hook.cmd\" /api/hooks/ask-user-question"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/.claude-plugin/bin/hook",
              "/api/hooks/post-tool-use"
            ],
            "commandWindows": "\"%CLAUDE_PLUGIN_ROOT%\\.claude-plugin\\bin\\hook.cmd\" /api/hooks/post-tool-use"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/.claude-plugin/bin/hook",
              "/api/hooks/stop"
            ],
            "commandWindows": "\"%CLAUDE_PLUGIN_ROOT%\\.claude-plugin\\bin\\hook.cmd\" /api/hooks/stop"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/.claude-plugin/bin/hook",
              "/api/hooks/subagent-start"
            ],
            "commandWindows": "\"%CLAUDE_PLUGIN_ROOT%\\.claude-plugin\\bin\\hook.cmd\" /api/hooks/subagent-start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/.claude-plugin/bin/hook",
              "/api/hooks/subagent-stop"
            ],
            "commandWindows": "\"%CLAUDE_PLUGIN_ROOT%\\.claude-plugin\\bin\\hook.cmd\" /api/hooks/subagent-stop"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/.claude-plugin/bin/hook",
              "/api/permissions/request"
            ],
            "commandWindows": "\"%CLAUDE_PLUGIN_ROOT%\\.claude-plugin\\bin\\hook.cmd\" /api/permissions/request"
          }
        ]
      }
    ]
  }
}
