{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://localhost:4004/api/hooks/session-start",
            "timeout": 30,
            "headers": {
              "X-Messaging-Socket": "$CLAUDE_CODE_MESSAGING_SOCKET"
            },
            "allowedEnvVars": [
              "CLAUDE_CODE_MESSAGING_SOCKET"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-sS",
              "--max-time",
              "30",
              "-X",
              "POST",
              "http://localhost:4004/api/hooks/pre-tool-use",
              "-H",
              "Content-Type: application/json",
              "--data-binary",
              "@-"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-sS",
              "--max-time",
              "30",
              "-X",
              "POST",
              "http://localhost:4004/api/hooks/post-tool-use",
              "-H",
              "Content-Type: application/json",
              "--data-binary",
              "@-"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-sS",
              "--max-time",
              "30",
              "-X",
              "POST",
              "http://localhost:4004/api/hooks/stop",
              "-H",
              "Content-Type: application/json",
              "--data-binary",
              "@-"
            ]
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-sS",
              "--max-time",
              "30",
              "-X",
              "POST",
              "http://localhost:4004/api/hooks/subagent-start",
              "-H",
              "Content-Type: application/json",
              "--data-binary",
              "@-"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-sS",
              "--max-time",
              "30",
              "-X",
              "POST",
              "http://localhost:4004/api/hooks/subagent-stop",
              "-H",
              "Content-Type: application/json",
              "--data-binary",
              "@-"
            ]
          }
        ]
      }
    ]
  }
}
