{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-sS",
              "--max-time",
              "30",
              "-X",
              "POST",
              "http://localhost:4004/api/hooks/session-start",
              "-H",
              "Content-Type: application/json",
              "-H",
              "X-Harness-Id: ${CMS_HARNESS_ID}",
              "--data-binary",
              "@-"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-sS",
              "--max-time",
              "30",
              "-X",
              "POST",
              "http://localhost:4004/api/hooks/pre-tool-use",
              "-H",
              "Content-Type: application/json",
              "-H",
              "X-Harness-Id: ${CMS_HARNESS_ID}",
              "--data-binary",
              "@-"
            ]
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-sS",
              "-X",
              "POST",
              "http://localhost:4004/api/hooks/ask-user-question",
              "-H",
              "Content-Type: application/json",
              "-H",
              "X-Harness-Id: ${CMS_HARNESS_ID}",
              "--data-binary",
              "@-"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-sS",
