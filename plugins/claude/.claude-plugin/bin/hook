#!/bin/bash
# Route Claude Code hooks to the local cms server.
#
# The cms server runs as a standalone service installed out-of-band — `brew
# services` (launchd) on macOS, the Shawl-wrapped Windows service via the MSI.
# This hook ONLY forwards events to the running server on its port; it does not
# install, start, or update the binary. (A plain release can't be cleanly
# daemonized from a hook anyway — that's the service manager's job.)
#
# If the server isn't running the POST simply fails and the hook is a no-op.

STDIN_DATA=$(cat)

# Default port is rewritten by the release packager when shipping the published
# plugin. CODEMYSPEC_PORT overrides for ad-hoc setups.
PORT="${CODEMYSPEC_PORT:-4004}"

# The endpoint, named by the caller when it knows it.
#
# Sniffing `hook_event_name` cannot express what `hooks.json` needs, because two
# of its entries are the *same* event: `ask-user-question` is a PreToolUse with
# `matcher: AskUserQuestion`, so both arrive here identical except for a
# `tool_name` deep in the payload. A router that dispatches on the event name
# would send both to `/api/hooks/pre-tool-use` and the question surface would
# never be reached.
#
# `hooks.json` already knows which endpoint each of its eight entries wants —
# that is what its matchers *are* — so it passes it. The sniffing below stays
# for callers that have no way to say, which is how the Codex router is invoked.
ENDPOINT="$1"

if [ -z "$ENDPOINT" ]; then
  EVENT=$(echo "$STDIN_DATA" | grep -o '"hook_event_name":"[^"]*"' | cut -d'"' -f4)

  case "$EVENT" in
    SessionStart)      ENDPOINT="/api/hooks/session-start" ;;
    PreToolUse)        ENDPOINT="/api/hooks/pre-tool-use" ;;
    PostToolUse)       ENDPOINT="/api/hooks/post-tool-use" ;;
    Stop)              ENDPOINT="/api/hooks/stop" ;;
    SubagentStart)     ENDPOINT="/api/hooks/subagent-start" ;;
    SubagentStop)      ENDPOINT="/api/hooks/subagent-stop" ;;
    PermissionRequest) ENDPOINT="/api/permissions/request" ;;
    *)                 exit 0 ;;
  esac
fi

# Which working copy this is, read at request time.
#
# A published plugin is installed once and serves every checkout, so it cannot
# carry an id in its URLs the way a generated per-harness config does, and it
# cannot send one from the environment either — nothing sets CMS_HARNESS_ID, and
# the server has an explicit clause treating an unexpanded `${...}` as absent.
# Both of the mechanisms that name a working copy are therefore unavailable to
# the one config real users install, which leaves the server guessing by walking
# up from a path, and its own warning says that "cannot tell two checkouts apart
# reliably".
#
# `.cms_harness.json` has been sitting in every working copy the whole time with
# the id in it. This reads it. Walking up because a hook's cwd is wherever the
# agent happens to be, which is not always the checkout root.
harness_id() {
  local dir="$PWD"
  while [ "$dir" != "/" ]; do
    if [ -f "$dir/.cms_harness.json" ]; then
      # grep, not jq: jq is not a dependency of this plugin and a hook that
      # fails on a missing binary is worse than one that sends no id.
      grep -o '"harness_id"[[:space:]]*:[[:space:]]*"[^"]*"' "$dir/.cms_harness.json" |
        head -1 | cut -d'"' -f4
      return
    fi
    dir="$(dirname "$dir")"
  done
}

ID="$(harness_id)"

# Sent only when found. An empty header is not better than none — the server
# treats "" the same as absent, but a header that is present and blank invites
# the reader to conclude the id was sent and rejected.
if [ -n "$ID" ]; then
  curl -s -X POST "http://localhost:${PORT}${ENDPOINT}" \
    -H "Content-Type: application/json" \
    -H "X-Working-Dir: $(pwd)" \
    -H "X-Harness-Id: $ID" \
    -d "$STDIN_DATA"
else
  curl -s -X POST "http://localhost:${PORT}${ENDPOINT}" \
    -H "Content-Type: application/json" \
    -H "X-Working-Dir: $(pwd)" \
    -d "$STDIN_DATA"
fi
