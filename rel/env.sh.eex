#!/bin/sh

# Fly.io (the server) needs distributed Erlang over IPv6. With empty Fly vars
# the node name resolves to an invalid `-name -@` and erl refuses to boot, so
# the IPv6 block stays guarded behind FLY_APP_NAME and only fires on Fly.
if [ -n "${FLY_APP_NAME:-}" ]; then
  # configure node for distributed erlang with IPV6 support
  export ERL_AFLAGS="-proto_dist inet6_tcp"
  export ECTO_IPV6="true"
  export DNS_CLUSTER_QUERY="${FLY_APP_NAME}.internal"
  export RELEASE_DISTRIBUTION="name"
  export RELEASE_NODE="${FLY_APP_NAME}-${FLY_IMAGE_REF##*-}@${FLY_PRIVATE_IP}"
elif [ -n "${CMS_FLAME_RUNNER_IP:-}" ]; then
  # Booted as a FLAME runner on a Hetzner burst box, not on Fly (story 877 —
  # CodeMySpec.Provisioning.BurstBox.start_runner/5 sets both of these before
  # starting this release). Its mere presence is the discriminator, the same
  # way FLY_APP_NAME's presence already discriminates the branch above —
  # nothing else sets this var, so there is no case where this box genuinely
  # wants it unset but happens to have it.
  #
  # CMS_FLAME_RUNNER_IP is this box's own address on Fly's 6PN, reached over a
  # WireGuard peer (CodeMySpec.Provisioning.BurstBox.FlyPeering) rather than
  # Fly's own networking — Fly's 6PN is IPv6-only, so the same `inet6_tcp`
  # distribution protocol the branch above needs for FLY_PRIVATE_IP is needed
  # here for the identical reason.
  #
  # CMS_FLAME_RUNNER_NAME, not CMS_FLAME_RUNNER_IP, supplies the *name* half
  # of RELEASE_NODE. Every runner this backend ever starts shares the one
  # box's one IP — unlike Fly, where FLY_PRIVATE_IP already differs per
  # machine — so node-identity uniqueness has to come from the name half
  # instead, and `start_runner/5` already makes that name unique per runner.
  export ERL_AFLAGS="-proto_dist inet6_tcp"
  export RELEASE_DISTRIBUTION="name"
  export RELEASE_NODE="${CMS_FLAME_RUNNER_NAME}@${CMS_FLAME_RUNNER_IP}"
else
  # Off Fly, distribution is opt-in per launcher command (the launcher exports
  # RELEASE_COMMAND before sourcing this file).
  #
  # The RPC commands — stop, restart, pid, remote, rpc — reach the running node
  # over distribution, so they only work if the server and the client agree on
  # a node name. Blanket "none" meant every one of them died with "Cannot run
  # --rpc-eval if the node is not alive (set --name or --sname)", leaving
  # `brew services stop` or `kill` as the only way to stop a running server.
  # A short name keeps this on 127.0.0.1 with no DNS or FQDN dependency, and
  # both sides read the same generated cookie out of RELEASE_ROOT.
  #
  # The name is overridable because "one cms per machine" only holds for a
  # desktop install. Sprites are many-per-host, and a fixed sname makes the
  # second one die at boot with "the name codemyspec@<host> seems to be in use"
  # — including when a sprite runs next to a developer's own cms.
  #
  # Everything else stays undistributed, which matters for two callers:
  # `eval` boots a *second* system whose sname would collide with the running
  # server's, and the stdio MCP path must never start epmd — erl's failure
  # text would land on stdout and corrupt the JSON-RPC channel.
  case "${RELEASE_COMMAND:-}" in
    start | start_iex | daemon | daemon_iex | stop | restart | pid | remote | rpc)
      # `cms migrate` arrives as `start`, but it is a one-shot that exits — and
      # the service is normally already running under this sname, so claiming
      # it again just fails to boot. It needs no node of its own.
      if [ -n "${CMS_MIGRATE:-}" ] || case " $* " in *" migrate "*) true ;; *) false ;; esac; then
        export RELEASE_DISTRIBUTION="none"
      else
        export RELEASE_DISTRIBUTION="sname"
        export RELEASE_NODE="${CMS_NODE_NAME:-codemyspec}"
      fi
      ;;
    *)
      export RELEASE_DISTRIBUTION="none"
      ;;
  esac
fi

# Uncomment to send crash dumps to stderr
# This can be useful for debugging, but may log sensitive information
# export ERL_CRASH_DUMP=/dev/stderr
# export ERL_CRASH_DUMP_BYTES=4096
